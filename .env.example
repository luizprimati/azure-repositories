# Mesmo service principal do app de IP (precisa da role AcrDelete no registry)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Limpeza do Container Registry
ACR_NAME=eveproduseastregistry
ACR_KEEP=1
# true = só mostra o que apagaria. Mude para false depois de conferir o log.
ACR_DRY_RUN=true
# Regex opcional para limitar os repositórios (ex: ^genericos/)
ACR_REPO_FILTER=
# Todo dia às 03:00 (horário de Brasília)
ACR_CRON=0 3 * * *
ACR_TIMEZONE=America/Sao_Paulo
